="1"><mxGeometry x="72" y="334" width="400" height="22" as="geometry"/></mxCell><mxCell id="c30" value="" style="fontFamily=Arial;fontColor=#000000;endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="734" as="sourcePoint"/><mxPoint x="1410" y="734" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="[Không được hoàn (sát ngày / giá không hoàn)]" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26" y="736" width="400" height="22" as="geometry"/></mxCell><mxCell id="c32" value="1. Bấm «Hủy đơn»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint"/><mxPoint x="584" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="2. Gửi yêu cầu hủy" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="176" as="sourcePoint"/><mxPoint x="834" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="3. Lấy đơn, ngày nhận phòng, tiền cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="212" as="sourcePoint"/><mxPoint x="1084" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="4. Thông tin đơn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1084" y="248" as="sourcePoint"/><mxPoint x="846" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="284" as="sourcePoint"/><mxPoint x="846" y="300" as="targetPoint"/><Array as="points"><mxPoint x="886" y="284"/><mxPoint x="886" y="300"/></Array></mxGeometry></mxCell><mxCell id="c37" value="5. Tính % hoàn theo chính sách và số giờ còn lại" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="892" y="276" width="260" height="24" as="geometry"/></mxCell><mxCell id="c38" value="6. Cập nhật «Đã hủy», ghi số tiền cần hoàn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="374" as="sourcePoint"/><mxPoint x="1084" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="7. Hủy thành công, chờ hoàn tiền" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="410" as="sourcePoint"/><mxPoint x="596" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="8. Hiển thị số tiền sẽ được hoàn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="446" as="sourcePoint"/><mxPoint x="90" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="9. Bấm «Hoàn cọc» trên đơn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="482" as="sourcePoint"/><mxPoint x="584" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="10. Yêu cầu hoàn tiền" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="518" as="sourcePoint"/><mxPoint x="834" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="11. Gửi yêu cầu hoàn giao dịch cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="554" as="sourcePoint"/><mxPoint x="1340" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="12. Kết quả hoàn tiền" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="590" as="sourcePoint"/><mxPoint x="846" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="13. Lưu mã hoàn, thời điểm hoàn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="626" as="sourcePoint"/><mxPoint x="1084" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="14. Hoàn cọc thành công" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="662" as="sourcePoint"/><mxPoint x="596" y="662" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="15. Hiển thị «Đã hoàn cọc», gửi email cho khách" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="698" as="sourcePoint"/><mxPoint x="340" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="6. Cập nhật «Đã hủy», giữ lại tiền cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="846" y="770" as="sourcePoint"/><mxPoint x="1084" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="7. &quot;Đơn đã hủy, tiền cọc không được hoàn&quot;" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="806" as="sourcePoint"/><mxPoint x="596" y="806" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="8. Hiển thị thông báo" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="842" as="sourcePoint"/><mxPoint x="90" y="842" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>