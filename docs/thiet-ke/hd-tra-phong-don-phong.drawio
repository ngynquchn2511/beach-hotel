<mxfile host="app.diagrams.net"><diagram id="hd-tra-phong" name="Hoạt động - Trả phòng và dọn phòng"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Lễ tân" style="swimlane;horizontal=1;startSize=30;html=1;fillColor=#F5F5F5;strokeColor=#1F6E9C;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="330" height="1200" as="geometry"/></mxCell><mxCell id="c2" value="Hệ thống" style="swimlane;horizontal=1;startSize=30;html=1;fillColor=#F5F5F5;strokeColor=#1F6E9C;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;container=0;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="330" height="1200" as="geometry"/></mxCell><mxCell id="c3" value="Nhân viên buồng phòng" style="swimlane;horizontal=1;startSize=30;html=1;fillColor=#F5F5F5;strokeColor=#1F6E9C;fontSize=13;fontStyle=1;swimlaneFillColor=#FFFFFF;container=0;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="330" height="1200" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Mở màn hình check-out&lt;br&gt;của đơn đang ở" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90.0" y="130" width="230" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Có phụ phí&lt;br&gt;phát sinh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6E9C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130.0" y="230" width="150" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Thêm phụ phí&lt;br&gt;(minibar, giặt ủi, hư hỏng)" style="rounded=1;whiteSpace