ize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint"/><mxPoint x="334" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="2. Yêu cầu thông tin nhận phòng" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="176" as="sourcePoint"/><mxPoint x="584" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="3. Lấy danh sách khách đã khai báo" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="212" as="sourcePoint"/><mxPoint x="834" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="4. Khách lưu trú" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="248" as="sourcePoint"/><mxPoint x="596" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="5. Thông tin đơn và khách" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="284" as="sourcePoint"/><mxPoint x="346" y="284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="6. Bổ sung giấy tờ còn thiếu, xác nhận" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="320" as="sourcePoint"/><mxPoint x="334" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="7. Gửi yêu cầu nhận phòng" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="356" as="sourcePoint"/><mxPoint x="584" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="392" as="sourcePoint"/><mxPoint x="596" y="408" as="targetPoint"/><Array as="points"><mxPoint x="636" y="392"/><mxPoint x="636" y="408"/></Array></mxGeometry></mxCell><mxCell id="c46" value="8. Kiểm tra đơn đã xác nhận, đã khai báo, phòng đã dọn" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="642" y="384" width="260" height="24" as="geometry"/></mxCell><mxCell id="c47" value="9. Lưu khách lưu trú" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="482" as="sourcePoint"/><mxPoint x="834" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="10. Cập nhật «Đang ở»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="518" as="sourcePoint"/><mxPoint x="1084" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="11. Cập nhật phòng «Có khách»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="554" as="sourcePoint"/><mxPoint x="1334" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="12. Nhận phòng thành công" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="590" as="sourcePoint"/><mxPoint x="346" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="13. Hiển thị trạng thái mới" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="626" as="sourcePoint"/><mxPoint x="90" y="626" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="9. &quot;Chưa đủ điều kiện nhận phòng&quot;" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="698" as="sourcePoint"/><mxPoint x="346" y="698" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="10. Hiển thị lý do" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="734" as="sourcePoint"/><mxPoint x="90" y="734" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>