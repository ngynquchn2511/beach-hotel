Color=#000000;rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="334" y="130" width="12" height="596" as="geometry"/></mxCell><mxCell id="c23" value="" style="fontFamily=Arial;fontColor=#000000;rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="584" y="166" width="12" height="524" as="geometry"/></mxCell><mxCell id="c24" value="" style="fontFamily=Arial;fontColor=#000000;rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1084" y="202" width="12" height="344" as="geometry"/></mxCell><mxCell id="c25" value="alt" style="fontFamily=Arial;fontColor=#000000;shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=22;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="492" width="1140" height="266" as="geometry"/></mxCell><mxCell id="c26" value="[Thanh toán thành công]" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="492" width="400" height="22" as="geometry"/></mxCell><mxCell id="c27" value="" style="fontFamily=Arial;fontColor=#000000;endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="640" as="sourcePoint"/><mxPoint x="1160" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="[Thất bại / sai chữ ký]" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26" y="642" width="400" height="22" as="geometry"/></mxCell><mxCell id="c29" value="1. Bấm «Đặt cọc qua VNPay»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint"/><mxPoint x="334" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="2. Yêu cầu tạo giao dịch cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="176" as="sourcePoint"/><mxPoint x="584" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="3. Lấy đơn, số tiền cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="212" as="sourcePoint"/><mxPoint x="1084" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="4. Đơn «Chờ cọc»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1084" y="248" as="sourcePoint"/><mxPoint x="596" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="284" as="sourcePoint"/><mxPoint x="596" y="300" as="targetPoint"/><Array as="points"><mxPoint x="636" y="284"/><mxPoint x="636" y="300"/></Array></mxGeometry></mxCell><mxCell id="c34" value="5. Tạo URL thanh toán có chữ ký" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="642" y="276" width="260" height="24" as="geometry"/></mxCell><mxCell id="c35" value="6. Chuyển khách sang cổng VNPay" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="334" as="sourcePoint"/><mxPoint x="840" y="334" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="7. Nhập thông tin thẻ, xác nhận OTP ngân hàng" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="370" as="sourcePoint"/><mxPoint x="840" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="8. Gọi lại kết quả (mã GD, số tiền, chữ ký)" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="406" as="sourcePoint"/><mxPoint x="596" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="442" as="sourcePoint"/><mxPoint x="596" y="458" as="targetPoint"/><Array as="points"><mxPoint x="636" y="442"/><mxPoint x="636" y="458"/></Array></mxGeometry></mxCell><mxCell id="c39" value="9. Kiểm tra chữ ký và số tiền" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="642" y="434" width="260" height="24" as="geometry"/></mxCell><mxCell id="c40" value="10. Cập nhật «Đã xác nhận», lưu mã giao dịch" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="532" as="sourcePoint"/><mxPoint x="1084" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="11. Kết quả thành công" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="568" as="sourcePoint"/><mxPoint x="346" y="568" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="12. Hiển thị «Đặt cọc thành công», gửi email" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="604" as="sourcePoint"/><mxPoint x="90" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="10. &quot;Thanh toán không thành công&quot;" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="676" as="sourcePoint"/><mxPoint x="346" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="11. Giữ đơn «Chờ cọc», cho thanh toán lại" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="712" as="sourcePoint"/><mxPoint x="90" y="712" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>