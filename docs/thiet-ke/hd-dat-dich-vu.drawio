ã xác nhận&lt;br&gt;và tiền cộng vào đơn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85.0" y="697.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="a9" value="Bấm «Từ chối»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725.0" y="811.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="a10" value="CANCELLED,&lt;br&gt;không phát sinh phí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405.0" y="811.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="a11" value="Thấy dịch vụ bị từ chối" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85.0" y="811.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="m2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="183.0" y="918.5" width="34" height="34" as="geometry"/></mxCell><mxCell id="e" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="185.0" y="1006.0000000000001" width="30" height="30" as="geometry"/></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;e