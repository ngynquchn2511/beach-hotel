etPoint"/></mxGeometry></mxCell><mxCell id="c31" value="[Không có ca đang mở]" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="26" y="556" width="400" height="22" as="geometry"/></mxCell><mxCell id="c32" value="1. Bấm «Chốt ca», nhập tiền mặt đếm được" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint"/><mxPoint x="334" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="2. Gửi yêu cầu chốt ca" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="176" as="sourcePoint"/><mxPoint x="584" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="3. Lấy ca đang mở" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="212" as="sourcePoint"/><mxPoint x="834" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="4. Ca hiện tại" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="248" as="sourcePoint"/><mxPoint x="596" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="5. Tổng thu tiền mặt / chuyển khoản / online trong ca" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="324" as="sourcePoint"/><mxPoint x="1084" y="324" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="6. Số liệu ca" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1084" y="360" as="sourcePoint"/><mxPoint x="596" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="396" as="sourcePoint"/><mxPoint x="596" y="412" as="targetPoint"/><Array as="points"><mxPoint x="636" y="396"/><mxPoint x="636" y="412"/></Array></mxGeometry></mxCell><mxCell id="c39" value="7. Tính tiền lệch = đếm được − dự kiến" style="fontFamily=Arial;fontColor=#000000;text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="642" y="388" width="260" height="24" as="geometry"/></mxCell><mxCell id="c40" value="8. Cập nhật «Đã chốt», người chốt, tiền nộp két" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="446" as="sourcePoint"/><mxPoint x="834" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="9. Biên bản chốt ca" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="482" as="sourcePoint"/><mxPoint x="346" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="10. Hiển thị số lệch, in biên bản" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="518" as="sourcePoint"/><mxPoint x="90" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="5. &quot;Chưa có ca nào đang mở&quot;" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="590" as="sourcePoint"/><mxPoint x="346" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="6. Hiển thị nút «Mở ca»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="626" as="sourcePoint"/><mxPoint x="90" y="626" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>