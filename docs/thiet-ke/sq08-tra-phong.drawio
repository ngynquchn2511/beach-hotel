ackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="140" as="sourcePoint"/><mxPoint x="334" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="2. Yêu cầu bảng tính tiền" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="176" as="sourcePoint"/><mxPoint x="584" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="3. Lấy tiền phòng, phụ phí, dịch vụ, tiền cọc" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="212" as="sourcePoint"/><mxPoint x="834" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="4. Chi tiết đơn" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="834" y="248" as="sourcePoint"/><mxPoint x="596" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="5. Số tiền còn phải thu" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="284" as="sourcePoint"/><mxPoint x="346" y="284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="6. Chọn phương thức (tiền mặt / chuyển khoản), xác nhận" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="320" as="sourcePoint"/><mxPoint x="334" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="7. Gửi yêu cầu trả phòng" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="356" as="sourcePoint"/><mxPoint x="584" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="8. Lưu thanh toán" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="432" as="sourcePoint"/><mxPoint x="1084" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="9. Cập nhật «Đã trả phòng», cộng điểm thưởng" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="468" as="sourcePoint"/><mxPoint x="834" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="10. Cập nhật phòng «Cần dọn»" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="596" y="504" as="sourcePoint"/><mxPoint x="1334" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="11. Trả phòng thành công" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="540" as="sourcePoint"/><mxPoint x="346" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="12. In hóa đơn PDF" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="576" as="sourcePoint"/><mxPoint x="90" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="8. &quot;Chỉ trả phòng được đơn đang ở&quot;" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="648" as="sourcePoint"/><mxPoint x="346" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="9. Hiển thị thông báo" style="fontFamily=Arial;fontColor=#000000;html=1;endArrow=open;endSize=8;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="334" y="684" as="sourcePoint"/><mxPoint x="90" y="684" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>