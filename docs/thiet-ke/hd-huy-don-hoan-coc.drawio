?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765.0" y="710.5" width="150" height="70" as="geometry"/></mxCell><mxCell id="a7" value="Bấm «Hoàn qua VNPay»" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725.0" y="830.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="a8" value="Gọi API hoàn tiền VNPay,&lt;br&gt;kiểm tra chữ ký phản hồi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405.0" y="830.5" width="230" height="58" as="geometry"/></mxCell><mxCell id="d4" value="VNPay hoàn&lt;br&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445.0" y="938.5000000000001" width="150" height="70" as="geometry"/></mxCell><mxCell id="a9" value="Nhận thông báo lỗi&lt;br&gt;(mã lỗi VNPay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725.0" y="944.5000000000001" width="230" height="58" as="geometry"/></mxCell><mxCell id="m1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="823.0" y="1051.5" width="34" height="34" as="geometry"/></mxCell><mxCell id="a10" value="Chuyển khoản trả khách, bấm&lt;br&gt;«Đã hoàn tiền» kèm ghi chú" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725.0" y="1125.0" width="230" height="58" as="geometry"/></mxCell><mxCell id="m2" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="503.0" y="1137.0" width="34" height="34" as="geometry"/></m