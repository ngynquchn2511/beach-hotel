<mxfile host="app.diagrams.net"><diagram id="uc-tong-quat" name="Use case tổng quát"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="Website Sóng Xanh Resort" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=none;strokeColor=#1F6E9C;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="560" height="960" as="geometry"/></mxCell><mxCell id="uc1" value="UC1. Đặt phòng trực tuyến" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="90" width="230" height="66" as="geometry"/></mxCell><mxCell id="uc8" value="UC8. Chăm sóc khách&lt;br&gt;(tin nhắn, đánh giá, liên hệ)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="190" width="230" height="66" as="geometry"/></mxCell><mxCell id="uc4" value="UC4. Đặt dịch vụ kèm đơn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="290" width="230" height="66" as="geometry"/></mxCell><mxCell id="uc2" value="UC2. Đặt cọc, hủy đơn&lt;br&gt;và hoàn cọc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="390" width="230" height="66" as="geometry"/></mxCell><mxCell id="uc3" value="UC3. Nhận phòng và&lt;br&gt;trả phòng tại quầy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="490" width="230" height="66" as="geometry"/></mxCell><mxCell id="uc6" value="UC6. Dọn phòng, kiểm phòng&lt;br&gt;và sự cố" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#1F6E9C